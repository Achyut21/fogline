# Copy to .env and fill in. Never commit .env or paste these values into a chat.

# Tiger Cloud: use the pooled connection string (Tiger console > service > Connect).
DATABASE_URL=
# Optional: a throwaway TimescaleDB for integration tests (local Docker). Never fogline-db.
DATABASE_URL_TEST=

# Gemini key from Google AI Studio. The AI SDK Google provider reads this name.
GOOGLE_GENERATIVE_AI_API_KEY=
# Model ID for fast text and Maps grounding (check AI Studio for the current ID).
GEMINI_MODEL=gemini-2.5-flash

# Random string; Vercel Cron sends it as a bearer token to /api/cron/* routes.
CRON_SECRET=

# Optional: MBTA V3 API key (the app uses keyless CDN feeds by default).
MBTA_API_KEY=

# Public (reaches the browser; never put secrets here).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Random string that signs the profile cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional: unfinished features to show, by PRD ID, e.g. F1,F2
NEXT_PUBLIC_FLAGS=
