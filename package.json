{
  "name": "fogline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "icons": "node scripts/pwa-icons.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "data:gtfs": "tsx scripts/gtfs.ts",
    "check:trips": "tsx scripts/check-trips.ts",
    "data:places": "node -e \"console.error('data:places arrives in Phase 2 (Builder B). See docs/DATA.md.'); process.exit(1)\"",
    "data:grades": "node -e \"console.error('data:grades arrives in Phase 2 (Builder B). See docs/DATA.md.'); process.exit(1)\"",
    "data:cards": "node -e \"console.error('data:cards arrives in Phase 2 (Builder B). See docs/DATA.md.'); process.exit(1)\"",
    "data:neighborhoods": "node -e \"console.error('data:neighborhoods arrives in Phase 2 (Builder B). See docs/DATA.md.'); process.exit(1)\"",
    "data:events": "node -e \"console.error('data:events arrives in Phase 2 (Builder B). See docs/DATA.md.'); process.exit(1)\"",
    "data:words": "node -e \"console.error('data:words arrives in Phase 2 (Builder B). See docs/DATA.md.'); process.exit(1)\"",
    "test:e2e:deployment": "playwright test tests/e2e/smoke.spec.ts tests/e2e/pwa.spec.ts tests/e2e/deployment.spec.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "h3-js": "^4.5.0",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@serwist/turbopack": "^9.5.15",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "csv-parse": "^7.0.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fflate": "^0.8.3",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serwist": "^9.5.15",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
